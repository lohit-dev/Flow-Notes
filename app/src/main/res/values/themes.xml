<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FlowNotes" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Shown by the system until the first frame; same indigo the Lottie splash sits on, no icon,
         so the hand-off to the animation is seamless. -->
    <style name="Theme.FlowNotes.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.FlowNotes</item>
    </style>
</resources>